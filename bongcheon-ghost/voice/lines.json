   "voice": "v1:SXfKPYquzIvNsUDKYsvgQrs0atDXeubQ8s14ua1R1RX-jGDdb7OCtHou-is04O0"
  }
 },
 "lines": [
  {
   "id": "l00",
   "t": 11.5,
   "e": 15,
   "role": "narr",
   "text": "রাত তখন প্রায় ১১টা ২০ মিনিট।"
  },
  {
   "id": "l01",
   "t": 15,
   "e": 19,
   "role": "narr",
   "text": "সিউলের বংচন-দং এলাকা।"
  },
  {
   "id": "l02",
   "t": 19,
   "e": 23.8,
   "role": "narr",
   "text": "একটি মেয়ে একা হেঁটে বাড়ি ফিরছিল।"
  },
  {
   "id": "l03",
   "t": 24.3,
   "e": 28,
   "role": "narr",
   "text": "হাইস্কুলের ছাত্রী… ফিরতে অনেক রাত হয়ে গেছে।"
  },
  {
   "id": "l04",
   "t": 28,
   "e": 31,
   "role": "narr",
   "text": "চারদিকে অদ্ভুত নীরবতা।"
  },
  {
   "id": "l05",
   "t": 31,
   "e": 34.5,
   "role": "narr",
   "text": "বাতি জ্বলছে… কিন্তু কোথাও কোনো মানুষ নেই।"
  },
  {
   "id": "l06",
   "t": 34.5,
   "e": 37,
   "role": "narr",
   "text": "মেয়েটি দ্রুত পা চালাল।"
  },
  {
   "id": "l07",
   "t": 37.5,
   "e": 41.5,
   "role": "narr",
   "text": "হঠাৎ… রাস্তার সামনে একজন মহিলা।"
  },
  {
   "id": "l08",
   "t": 41.5,
   "e": 46,
   "role": "narr",
   "text": "পরনে ময়লা গোলাপি পায়জামা।"
  },
  {
   "id": "l09",
   "t": 46.2,
   "e": 49.5,
   "role": "narr",
   "text": "কিন্তু… সে স্বাভাবিকভাবে হাঁটছিল না।"
  },
  {
   "id": "l10",
   "t": 49.5,
   "e": 53,
   "role": "narr",
   "text": "হাত ঝুলে আছে, পা যেন ভাঙা, শরীর একদিকে কাত।"
  },
  {
   "id": "l11",
   "t": 53.3,
   "e": 56.5,
   "role": "girl",
   "text": "মহিলাটি কি অসুস্থ? কোনো দুর্ঘটনা?"
  },
  {
   "id": "l12",
   "t": 56.5,
   "e": 60,
   "role": "narr",
   "text": "কাছে যাওয়ার সাহস হলো না… সে দূরত্ব রেখে হাঁটল।"
  },
  {
   "id": "l13",
   "t": 64,
   "e": 67,
   "role": "narr",
   "text": "হঠাৎ মহিলাটি থেমে গেল।"
  },
  {
   "id": "l14",
   "t": 67,
   "e": 70,
   "role": "narr",
   "text": "মেয়েটিও থেমে গেল।"
  },
  {
   "id": "l15",
   "t": 70,
   "e": 72,
   "role": "narr",
   "text": "তারপর…"
  },
  {
   "id": "l16",
   "t": 72.3,
   "e": 76,
   "role": "narr",
   "text": "মাথাটা ধীরে ধীরে পেছনে ঘুরতে লাগল…"
  },
  {
   "id": "l17",
   "t": 76,
   "e": 80,
   "role": "narr",
   "text": "কিন্তু শরীরটা একটুও নড়ছে না!"
  },
  {
   "id": "l18",
   "t": 80.3,
   "e": 83.5,
   "role": "narr",
   "text": "চোখ দুটি অস্বাভাবিক বড়… মুখটা বিকৃত।"
  },
  {
   "id": "l19",
   "t": 83.8,
   "e": 87.6,
   "role": "ghost",
   "text": "내 아기 어디 있어?"
  },
  {
   "id": "l20",
   "t": 88,
   "e": 91.8,
   "role": "ghost",
   "text": "내 아기 봤어?"
  },
  {
   "id": "l21",
   "t": 92.3,
   "e": 95.5,
   "role": "narr",
   "text": "মনে হলো, এখনই অজ্ঞান হয়ে যাবে…"
  },
  {
   "id": "l22",
   "t": 95.5,
   "e": 98.5,
   "role": "girl",
   "text": "ও… ওইদিকে…"
  },
  {
   "id": "l23",
   "t": 98.5,
   "e": 101.3,
   "role": "narr",
   "text": "মহিলাটি সেদিকে হাঁটতে শুরু করল।"
  },
  {
   "id": "l24",
   "t": 101.3,
   "e": 104,
   "role": "narr",
   "text": "সে স্বস্তির নিঃশ্বাস ফেলল…"
  },
  {
   "id": "l25",
   "t": 108,
   "e": 111.5,
   "role": "narr",
   "text": "যতটা সম্ভব নিঃশব্দে… বাড়ির দিকে।"
  },
  {
   "id": "l26",
   "t": 111.5,
   "e": 116,
   "role": "narr",
   "text": "মনে হচ্ছিল, পেছন থেকে কেউ তাকে দেখছে।"
  },
  {
   "id": "l27",
   "t": 117.2,
   "e": 121,
   "role": "ghost",
   "text": "거기 내 아기 없잖아!!!"
  },
  {
   "id": "l28",
   "t": 121.3,
   "e": 124.5,
   "role": "narr",
   "text": "সেই মহিলা তার দিকে ছুটে আসছে!"
  },
  {
   "id": "l29",
   "t": 124.5,
   "e": 127.3,
   "role": "narr",
   "text": "চিৎকার করতে চাইল… কিন্তু গলা দিয়ে শব্দ বের হলো না।"
  },
  {
   "id": "l30",
   "t": 128.9,
   "e": 131,
   "role": "narr",
   "text": "আর তারপর… সবকিছু অন্ধকার।"
  },
  {
   "id": "l31",
   "t": 135.3,
   "e": 138.5,
   "role": "narr",
   "text": "কিছুক্ষণ পর মেয়েটির জ্ঞান ফিরল।"
  },
  {
   "id": "l32",
   "t": 138.5,
   "e": 142,
   "role": "other",
   "text": "তুমি ঠিক আছ? কী হয়েছিল তোমার?"
  },
  {
   "id": "l33",
   "t": 142,
   "e": 146,
   "role": "narr",
   "text": "সেই মহিলার কোনো চিহ্ন নেই… কেউ তাকে দেখেনি।"
  },
  {
   "id": "l34",
   "t": 146,
   "e": 150,
   "role": "narr",
   "text": "কিন্তু মেয়েটি নিশ্চিত… এটা স্বপ্ন ছিল না।"
  },
  {
   "id": "l35",
   "t": 154,
   "e": 158,
   "role": "narr",
   "text": "এই এলাকায় একসময় থাকতেন মিসেস চো।"
  },
  {
   "id": "l36",
   "t": 158,
   "e": 161.5,
   "role": "narr",
   "text": "তার ছিল দুই বছরের একটি ছোট্ট মেয়ে।"
  },
  {
   "id": "l37",
   "t": 161.5,
   "e": 164.5,
   "role": "narr",
   "text": "কিন্তু বিবাহবিচ্ছেদের পর…"
  },
  {
   "id": "l38",
   "t": 164.5,
   "e": 168,
   "role": "narr",
   "text": "তিনি মেয়ের অভিভাবকত্ব হারালেন।"
  },
  {
   "id": "l39",
   "t": 168,
   "e": 171.5,
   "role": "narr",
   "text": "দিনের পর দিন শুধু মেয়ের কথা ভাবতেন…"
  },
  {
   "id": "l40",
   "t": 171.5,
   "e": 176,
   "role": "narr",
   "text": "কিংবদন্তি বলে, উঁচু ভবন থেকে লাফ দিয়ে তিনি প্রাণ হারান।"
  },
  {
   "id": "l41",
   "t": 176,
   "e": 180,
   "role": "narr",
   "text": "তার আত্মা নাকি আজও সেই রাস্তায় ঘুরে বেড়ায়…"
  },
  {
   "id": "l42",
   "t": 184,
   "e": 187.5,
   "role": "narr",
   "text": "একজন মা… যে মৃত্যুর পরও সন্তানকে খুঁজে বেড়ায়।"
  },
  {
   "id": "l43",
   "t": 187.5,
   "e": 191,
   "role": "narr",
   "text": "ভুল রাস্তা দেখালে… সে ভয়ংকর ক্ষিপ্ত হয়ে ওঠে।"
  },
  {
   "id": "l44",
   "t": 191,
   "e": 194.5,
   "role": "narr",
   "text": "আর যদি কোনো রাতে সে তোমার সামনে এসে দাঁড়ায়…"
  },
  {
   "id": "l45",
   "t": 194.5,
   "e": 197,
   "role": "ghost",
   "text": "내 아기 어디 있어?"
  }
 ]
}