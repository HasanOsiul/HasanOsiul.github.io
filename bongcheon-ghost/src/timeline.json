  "subs": [
    { "t": 11.5, "e": 15, "text": "রাত তখন প্রায় ১১টা ২০ মিনিট।" },
    { "t": 15, "e": 19, "text": "সিউলের বংচন-দং এলাকা।" },
    { "t": 19, "e": 23.8, "text": "একটি মেয়ে একা হেঁটে বাড়ি ফিরছিল।" },
    { "t": 24.3, "e": 28, "text": "হাইস্কুলের ছাত্রী… পড়া শেষে ফিরতে অনেক রাত হয়ে গেছে।" },
    { "t": 28, "e": 31, "text": "চারদিকে অদ্ভুত নীরবতা।" },
    { "t": 31, "e": 34.5, "text": "বাতি জ্বলছে… কিন্তু কোথাও কোনো মানুষ নেই।" },
    { "t": 34.5, "e": 37, "text": "মেয়েটি দ্রুত পা চালাল।", "tag": "দ্রুত নিঃশ্বাস" },
    { "t": 37.5, "e": 41.5, "text": "হঠাৎ… রাস্তার সামনে একজন মহিলা।", "tag": "শ্বাস আটকে যায়" },
    { "t": 41.5, "e": 46, "text": "পরনে ময়লা গোলাপি পায়জামা।" },
    { "t": 46.2, "e": 49.5, "text": "কিন্তু… সে স্বাভাবিকভাবে হাঁটছিল না।" },
    { "t": 49.5, "e": 53, "text": "হাত ঝুলে আছে, পা যেন ভাঙা, শরীর একদিকে কাত।" },
    { "t": 53.3, "e": 56.5, "text": "“মহিলাটি কি অসুস্থ? কোনো দুর্ঘটনা?”", "kind": "girl", "tag": "বুক ধড়ফড়" },
    { "t": 56.5, "e": 60, "text": "কাছে যাওয়ার সাহস হলো না… সে দূরত্ব রেখে হাঁটল।" },
    { "t": 64, "e": 67, "text": "হঠাৎ মহিলাটি থেমে গেল।" },
    { "t": 67, "e": 70, "text": "মেয়েটিও থেমে গেল।", "tag": "নিস্তব্ধতা" },
    { "t": 70, "e": 72, "text": "তারপর…" },
    { "t": 72.3, "e": 76, "text": "মাথাটা ধীরে ধীরে পেছনে ঘুরতে লাগল…", "tag": "হাড় মটমট" },
    { "t": 76, "e": 80, "text": "কিন্তু শরীরটা একটুও নড়ছে না!" },
    { "t": 80.3, "e": 83.5, "text": "চোখ দুটি অস্বাভাবিক বড়… মুখটা বিকৃত।", "tag": "আঁতকে ওঠা" },
    { "t": 83.8, "e": 87.6, "text": "“আমার বাচ্চা কোথায়?”", "ko": "내 아기 어디 있어?", "kind": "ghost" },
    { "t": 88, "e": 91.8, "text": "“তুমি কি আমার বাচ্চাকে দেখেছ?”", "ko": "내 아기 봤어?", "kind": "ghost" },
    { "t": 92.3, "e": 95.5, "text": "মনে হলো, এখনই অজ্ঞান হয়ে যাবে…", "tag": "কাঁপা নিঃশ্বাস" },
    { "t": 95.5, "e": 98.5, "text": "“ও… ওইদিকে…”", "ko": "저… 저쪽에…", "kind": "girl" },
    { "t": 98.5, "e": 101.3, "text": "মহিলাটি সঙ্গে সঙ্গে সেদিকে হাঁটতে শুরু করল।" },
    { "t": 101.3, "e": 104, "text": "সে স্বস্তির নিঃশ্বাস ফেলল…", "tag": "স্বস্তির নিঃশ্বাস" },
    { "t": 108, "e": 111.5, "text": "যতটা সম্ভব নিঃশব্দে… বাড়ির দিকে।" },
    { "t": 111.5, "e": 116, "text": "মনে হচ্ছিল, পেছন থেকে কেউ তাকে দেখছে।", "tag": "ফিসফিস" },
    { "t": 117.2, "e": 121, "text": "“ওখানে তো আমার বাচ্চা নেই!!!”", "ko": "거기 내 아기 없잖아!!!", "kind": "scream" },
    { "t": 121.3, "e": 124.5, "text": "সেই মহিলা তার দিকে ছুটে আসছে!", "tag": "আতঙ্ক" },
    { "t": 124.5, "e": 127.3, "text": "চিৎকার করতে চাইল… কিন্তু গলা দিয়ে শব্দ বের হলো না।", "tag": "দম আটকে যাওয়া" },
    { "t": 128.9, "e": 131, "text": "আর তারপর… সবকিছু অন্ধকার।" },
    { "t": 135.3, "e": 138.5, "text": "কিছুক্ষণ পর মেয়েটির জ্ঞান ফিরল।", "tag": "গভীর শ্বাস" },
    { "t": 138.5, "e": 142, "text": "“তুমি ঠিক আছ? কী হয়েছিল তোমার?”", "ko": "괜찮아? 무슨 일이야?", "kind": "other" },
    { "t": 142, "e": 146, "text": "গোলাপি পায়জামা পরা মহিলার কোনো চিহ্ন নেই… কেউ তাকে দেখেনি।" },
    { "t": 146, "e": 150, "text": "কিন্তু মেয়েটি নিশ্চিত… এটা স্বপ্ন ছিল না।" },
    { "t": 154, "e": 158, "text": "এই এলাকায় একসময় থাকতেন মিসেস চো।" },
    { "t": 158, "e": 161.5, "text": "তার ছিল দুই বছরের একটি ছোট্ট মেয়ে।" },
    { "t": 161.5, "e": 164.5, "text": "কিন্তু বিবাহবিচ্ছেদের পর…" },
    { "t": 164.5, "e": 168, "text": "তিনি মেয়ের অভিভাবকত্ব হারালেন।", "tag": "কান্না" },
    { "t": 168, "e": 171.5, "text": "দিনের পর দিন শুধু মেয়ের কথা ভাবতেন…" },
    { "t": 171.5, "e": 176, "text": "কিংবদন্তি বলে, একদিন উঁচু ভবন থেকে লাফ দিয়ে তিনি প্রাণ হারান।" },
    { "t": 176, "e": 180, "text": "তার আত্মা নাকি আজও সেই রাস্তায় ঘুরে বেড়ায়…" },
    { "t": 184, "e": 187.5, "text": "একজন মা… যে মৃত্যুর পরও সন্তানকে খুঁজে বেড়ায়।" },
    { "t": 187.5, "e": 191, "text": "কেউ ভুল রাস্তা দেখালে… সে ভয়ংকর ক্ষিপ্ত হয়ে ওঠে।" },
    { "t": 191, "e": 194.5, "text": "আর যদি কোনো রাতে সে তোমার সামনে এসে দাঁড়ায়…" },
    { "t": 194.5, "e": 197, "text": "“আমার বাচ্চা কোথায়?”", "ko": "내 아기 어디 있어?", "kind": "ghost" }
  ]
}
